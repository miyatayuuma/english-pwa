{
  "name": "english-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:reorder-browser": "node --test tests/reorderBrowser.test.mjs",
    "vocab:check-derived": "node scripts/vocabulary/validate-vocabulary-v3.mjs --check-report && node scripts/vocabulary/validate-final-admission-materialization.mjs && node scripts/vocabulary/validate-meaning-canonical-audit.mjs --check-production",
    "vocab:validate": "node scripts/vocabulary/validate-vocabulary-v3.mjs --check-report && node scripts/vocabulary/validate-source-sentence-integrity.mjs && node scripts/vocabulary/validate-final-admission-occurrences.mjs && node scripts/vocabulary/validate-final-admission-materialization.mjs && node scripts/vocabulary/validate-meaning-canonical-audit.mjs --check-production",
    "vocab:sync-derived": "node scripts/vocabulary/validate-vocabulary-v3.mjs && node scripts/vocabulary/validate-final-admission-materialization.mjs --sync-inventory",
    "vocab:validate-admission-occurrences": "node scripts/vocabulary/validate-final-admission-occurrences.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
