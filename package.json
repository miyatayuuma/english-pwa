{
  "name": "english-pwa",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "speech:validate-td-cluster-before-to": "node scripts/speech/validate-vocabulary-td-cluster-before-to.mjs",
    "speech:validate-asr-09b": "node scripts/speech/validate-asr-09b-fixed-grammatical-equivalence.mjs",
    "speech:validate-asr-09c": "node scripts/speech/validate-asr-09c-contextual-grammatical-equivalence.mjs",
    "speech:validate-asr-09d": "node scripts/speech/validate-asr-09d-contextual-grammatical-equivalence.mjs",
    "speech:benchmark-asr-09d": "node scripts/speech/benchmark-asr-09d-contextual-equivalence.mjs",
    "speech:benchmark-asr-targeted-collisions": "node scripts/speech/benchmark-asr-targeted-recognition-collisions.mjs",
    "test:reorder-browser": "node --test tests/reorderBrowser.test.mjs",
    "vocab:check-derived": "node scripts/vocabulary/validate-vocabulary-v3.mjs --check-report && node scripts/vocabulary/validate-vocabulary-grammar-role.mjs && node scripts/vocabulary/validate-final-admission-materialization.mjs && node scripts/vocabulary/validate-meaning-canonical-audit.mjs --check-production && node scripts/vocabulary/validate-japanese-prompt-authority-materialization.mjs",
    "vocab:validate": "node scripts/vocabulary/validate-vocabulary-v3.mjs --check-report && node scripts/vocabulary/validate-vocabulary-grammar-role.mjs && node scripts/vocabulary/validate-source-sentence-integrity.mjs && node scripts/vocabulary/validate-final-admission-occurrences.mjs && node scripts/vocabulary/validate-final-admission-materialization.mjs && node scripts/vocabulary/validate-meaning-canonical-audit.mjs --check-production && node scripts/vocabulary/validate-japanese-prompt-authority-materialization.mjs",
    "vocab:sync-derived": "node scripts/vocabulary/validate-vocabulary-v3.mjs && node scripts/vocabulary/validate-final-admission-materialization.mjs --sync-inventory",
    "vocab:validate-admission-occurrences": "node scripts/vocabulary/validate-final-admission-occurrences.mjs",
    "native:stage": "node scripts/native/stage-web.mjs",
    "native:sync": "npm run native:stage && cap sync android",
    "native:build": "npm run native:sync && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "es-module-lexer": "1.7.0",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2"
  }
}
